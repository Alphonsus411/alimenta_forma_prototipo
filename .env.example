# Entorno: development, test o production
APP_ENV=development
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (SQLite local por defecto)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=api/apialimentaforma/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=0
DB_OPTIONS={}

# Orígenes completos, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Archivos subidos y estáticos
MEDIA_URL=/media/
MEDIA_ROOT=api/apialimentaforma/media
STATIC_URL=/static/
STATIC_ROOT=api/apialimentaforma/staticfiles
STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
STORAGE_OPTIONS={}
STATIC_STORAGE_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage
STATIC_STORAGE_OPTIONS={}

# Seguridad de producción
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
TRUST_X_FORWARDED_PROTO=false
